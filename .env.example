# Copy to .env and fill in only the providers you want. Missing keys just grey out that model.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Models, model IDs and prices are in models.json. These optionally override a model ID:
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# QWEN_FLASH_MODEL=qwen3.8-flash
# GROQ_QWEN_MODEL=qwen/qwen3.8-27b

# Optional: self-hosted servers
# OLLAMA_URL=http://localhost:11434/v1
# VLLM_URL=http://localhost:8000/v1

# Hosting
APP_PASSWORD=
# APP_USER=vet
# RATE_LIMIT_PER_MIN=20

